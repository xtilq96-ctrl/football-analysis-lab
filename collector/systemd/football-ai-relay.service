[Unit]
Description=Football AI signed read-only data relay
After=network-online.target football-ai-collector.service
Wants=network-online.target

[Service]
Type=simple
User=football-ai
Group=football-ai
ExecStart=/opt/football-ai/collector/api_server.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadOnlyPaths=/var/lib/football-ai /etc/football-ai/relay-secret

[Install]
WantedBy=multi-user.target
