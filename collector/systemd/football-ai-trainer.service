[Unit]
Description=Train and validate Football AI candidate models
After=football-ai-collector.service

[Service]
Type=oneshot
User=football-ai
Group=football-ai
ExecStart=/opt/football-ai/collector/trainer.py
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/football-ai
